+// Image storage may be allocated/replaced after glBindImageTexture. Resolve the
+// current allocation at draw/dispatch time; never retain a stale texture view.
+id<MTLTexture> resolveImageTexture(const ProgramObject &program, size_t imageIndex, int stage) {
+	const auto &image = program.storage_images[imageIndex];
+	const auto &info = image.stage[stage];
+	const GLint unit = imageIndex < program.image_units.size() ? program.image_units[imageIndex] : -1;
+	if (unit < 0 || unit >= GL4METAL_MAX_IMAGE_UNITS || info.slot >= 32) {
+		gl4metalSetError(GL_INVALID_OPERATION); return nil;
+	}
+	auto &binding = ctx.image_unit_bindings[unit];
+	auto found = ctx.texture_objects.find(binding.texture);
+	if (!binding.texture || found == ctx.texture_objects.end()) {
+		gl4metalSetError(GL_INVALID_OPERATION); return nil;
+	}
+	const auto &object = found->second;
+	id<MTLTexture> source = object.texture;
+	const MTLTextureType expectedType = image.is_3d ? MTLTextureType3D : MTLTextureType2D;
+	const unsigned formatClass = imageFormatClass(binding.format);
+	const GLenum shaderComponent = image.gl_type == GL_INT_IMAGE_2D || image.gl_type == GL_INT_IMAGE_3D ? GL_INT :
+		image.gl_type == GL_UNSIGNED_INT_IMAGE_2D || image.gl_type == GL_UNSIGNED_INT_IMAGE_3D ? GL_UNSIGNED_INT : GL_FLOAT;
+	if (!source || source.textureType != expectedType || binding.level < 0 ||
+		(NSUInteger)binding.level >= source.mipmapLevelCount || (image.is_3d && !binding.layered) ||
+		!formatClass || formatClass != imageFormatClass(object.internalformat) ||
+		shaderComponent != imageComponentType(binding.format) ||
+		(image.format && image.format != binding.format)) {
+		gl4metalSetError(GL_INVALID_OPERATION);
+		GL4METAL_LOG("image '%s': incompatible texture, mip, layer mode or format", image.name.c_str());
+		return nil;
+	}
+	const bool reads = !info.write_only, writes = !info.read_only;
+	if ((reads && (binding.access == GL_WRITE_ONLY || !(source.usage & MTLTextureUsageShaderRead))) ||
+		(writes && (binding.access == GL_READ_ONLY || !(source.usage & MTLTextureUsageShaderWrite)))) {
+		gl4metalSetError(GL_INVALID_OPERATION); return nil;
+	}
+	if (binding.view_source != source || !binding.view) {
+		const MTLPixelFormat pixelFormat = metalPixelFormat(binding.format);
+		binding.view = [source newTextureViewWithPixelFormat:pixelFormat textureType:expectedType
+			levels:NSMakeRange((NSUInteger)binding.level, 1) slices:NSMakeRange(0, 1)];
+		binding.view_source = source;
+		if (!binding.view) {
+			gl4metalSetError(GL_INVALID_OPERATION);
+			GL4METAL_LOG("image '%s': Metal cannot create the requested image view", image.name.c_str());
+		}
+	}
+	return binding.view;
+}
