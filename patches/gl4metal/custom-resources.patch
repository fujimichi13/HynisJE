+inline unsigned imageFormatClass(GLenum format) {
+	switch (format) {
+		case GL_R8: case GL_R8_SNORM: case GL_R8I: case GL_R8UI: return 0x108;
+		case GL_R16: case GL_R16_SNORM: case GL_R16F: case GL_R16I: case GL_R16UI: return 0x110;
+		case GL_R32F: case GL_R32I: case GL_R32UI: return 0x120;
+		case GL_RG8: case GL_RG8_SNORM: case GL_RG8I: case GL_RG8UI: return 0x208;
+		case GL_RG16: case GL_RG16_SNORM: case GL_RG16F: case GL_RG16I: case GL_RG16UI: return 0x210;
+		case GL_RG32F: case GL_RG32I: case GL_RG32UI: return 0x220;
+		case GL_RGBA8: case GL_RGBA8_SNORM: case GL_RGBA8I: case GL_RGBA8UI: return 0x408;
