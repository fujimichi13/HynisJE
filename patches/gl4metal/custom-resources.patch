+int gl4metalRunResourceTests() {
+	@autoreleasepool {
+		if (!gl4metalInit() || !gl4metalSupportsComputeShaders()) return 77;
+		try {
+			Resources resources;
+			noError("initial state");
+			glGenTextures(1, &resources.texture);
+			glBindTexture(GL_TEXTURE_3D, resources.texture);
+			// Binding before allocation must resolve the eventual allocation at dispatch.
+			glBindImageTexture(5, resources.texture, 1, GL_TRUE, 0, GL_READ_WRITE, GL_R32UI);
+			glTexStorage3D(GL_TEXTURE_3D, 3, GL_R32UI, 4, 4, 4);
+			GLint immutable = 0, levels = 0;
+			glGetTexParameteriv(GL_TEXTURE_3D, GL_TEXTURE_IMMUTABLE_FORMAT, &immutable);
+			glGetTexParameteriv(GL_TEXTURE_3D, GL_TEXTURE_IMMUTABLE_LEVELS, &levels);
+			require(immutable && levels == 3, "immutable volume metadata");
+			std::array<GLuint, 8> initial{}, pixels{}, result{};
+			for (GLuint i = 0; i < initial.size(); ++i) initial[i] = 0xf1234500u + i;
+			glTexSubImage3D(GL_TEXTURE_3D, 1, 0, 0, 0, 2, 2, 2, GL_RED_INTEGER, GL_UNSIGNED_INT, initial.data());
+
+			glGenBuffers(2, resources.buffers);
+			GLint alignment = 0;
+			glGetIntegerv(GL_SHADER_STORAGE_BUFFER_OFFSET_ALIGNMENT, &alignment);
+			const GLintptr offset = std::max(alignment, 16);
+			glBindBuffer(GL_SHADER_STORAGE_BUFFER, resources.buffers[0]);
+			glBufferData(GL_SHADER_STORAGE_BUFFER, offset + sizeof(result), nullptr, GL_DYNAMIC_COPY);
+			const GLuint sentinel = 0x13579bdf;
+			glClearBufferData(GL_SHADER_STORAGE_BUFFER, GL_R32UI, GL_RED_INTEGER, GL_UNSIGNED_INT, &sentinel);
+			glClearBufferSubData(GL_SHADER_STORAGE_BUFFER, GL_R32UI, offset, sizeof(result), GL_RED_INTEGER, GL_UNSIGNED_INT, nullptr);
+			glBindBufferRange(GL_SHADER_STORAGE_BUFFER, 2, resources.buffers[0], offset, sizeof(result));
+			const GLuint program = resources.compute(R"(#version 450
+#define VOLUME_UNIT (3 + 2)
+layout(local_size_x=1, local_size_y=1, local_size_z=1) in;
+layout(r32ui, binding=VOLUME_UNIT) uniform uimage3D volume;
+layout(std430, binding=2) buffer Results { uint values[]; } outputData;
+void main() {
+    ivec3 p = ivec3(gl_GlobalInvocationID);
+    uint i = uint(p.x + 2 * (p.y + 2 * p.z));
+    uint value = imageLoad(volume, p).x + uint(outputData.values.length()) + gl_NumWorkGroups.x;
+    imageStore(volume, p, uvec4(value));
+    outputData.values[i] = value;
+})");
+			const GLuint block = glGetProgramResourceIndex(program, GL_SHADER_STORAGE_BLOCK, "Results");
+			require(block != GL_INVALID_INDEX, "SSBO block reflection");
+			const GLenum properties[] = {GL_BUFFER_BINDING, GL_BUFFER_DATA_SIZE};
+			GLint metadata[2] = {};
+			glGetProgramResourceiv(program, GL_SHADER_STORAGE_BLOCK, block, 2, properties, 2, nullptr, metadata);
+			require(metadata[0] == 2 && metadata[1] == 4, "SSBO binding and runtime tail size");
+			const GLint imageLocation = glGetUniformLocation(program, "volume");
+			require(imageLocation >= 0, "image uniform location");
+			glUseProgram(program);
+			glUniform1i(imageLocation, 5);
+			noError("resource setup");
+			glDispatchCompute(2, 2, 2);
+			glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT | GL_TEXTURE_UPDATE_BARRIER_BIT);
+			// A partial CPU write must preserve the GPU's writes to all other bytes.
+			const GLuint replacement = 0xdeadbeef;
+			glBufferSubData(GL_SHADER_STORAGE_BUFFER, offset, sizeof(replacement), &replacement);
+			glGetBufferSubData(GL_SHADER_STORAGE_BUFFER, offset, sizeof(result), result.data());
+			glGetTexImage(GL_TEXTURE_3D, 1, GL_RED_INTEGER, GL_UNSIGNED_INT, pixels.data());
+			for (size_t i = 0; i < initial.size(); ++i) {
+				require(pixels[i] == initial[i] + 10, "3D image mip writes / exact uint32 readback");
+				require(result[i] == (i == 0 ? replacement : initial[i] + 10), "partial SSBO update preserves GPU writes");
+			}
+			GLuint prefix = 0;
+			glGetBufferSubData(GL_SHADER_STORAGE_BUFFER, 0, sizeof(prefix), &prefix);
+			require(prefix == sentinel, "ranged SSBO dispatch preserves prefix");
+			noError("direct dispatch and readback");
+
+			// Produce indirect arguments on the GPU, then consume them after a barrier.
+			const GLuint argumentProgram = resources.compute(R"(#version 430
+layout(local_size_x=1) in;
+layout(std430, binding=3) buffer Arguments { uint x; uint y; uint z; } args;
+void main() { args.x = 2; args.y = 2; args.z = 2; }
+)");
+			glBindBuffer(GL_DISPATCH_INDIRECT_BUFFER, resources.buffers[1]);
+			glBufferData(GL_DISPATCH_INDIRECT_BUFFER, 12, nullptr, GL_DYNAMIC_COPY);
+			glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 3, resources.buffers[1]);
+			glUseProgram(argumentProgram);
+			glDispatchCompute(1, 1, 1);
+			glMemoryBarrier(GL_COMMAND_BARRIER_BIT);
+			glUseProgram(program);
+			glDispatchComputeIndirect(0);
+			glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT | GL_TEXTURE_UPDATE_BARRIER_BIT);
+			glBindBuffer(GL_SHADER_STORAGE_BUFFER, resources.buffers[0]);
+			auto *mapped = static_cast<const GLuint *>(glMapBufferRange(GL_SHADER_STORAGE_BUFFER, offset, sizeof(result), GL_MAP_READ_BIT));
+			require(mapped != nullptr, "map GPU-written range");
+			GLint64 mapOffset = 0, mapLength = 0;
+			void *mapPointer = nullptr;
+			glGetBufferParameteri64v(GL_SHADER_STORAGE_BUFFER, GL_BUFFER_MAP_OFFSET, &mapOffset);
+			glGetBufferParameteri64v(GL_SHADER_STORAGE_BUFFER, GL_BUFFER_MAP_LENGTH, &mapLength);
+			glGetBufferPointerv(GL_SHADER_STORAGE_BUFFER, GL_BUFFER_MAP_POINTER, &mapPointer);
+			require(mapOffset == offset && mapLength == sizeof(result) && mapPointer == mapped, "mapped range queries");
+			for (size_t i = 0; i < initial.size(); ++i) require(mapped[i] == initial[i] + 20, "GPU-generated indirect dispatch");
+			glDispatchCompute(1, 1, 1);
+			require(glGetError() == GL_INVALID_OPERATION, "reject dispatch using a mapped SSBO");
+			require(glUnmapBuffer(GL_SHADER_STORAGE_BUFFER), "unmap SSBO");
+			glClearTexImage(resources.texture, 1, GL_RED_INTEGER, GL_UNSIGNED_INT, nullptr);
+			glGetTexImage(GL_TEXTURE_3D, 1, GL_RED_INTEGER, GL_UNSIGNED_INT, pixels.data());
+			for (GLuint pixel : pixels) require(pixel == 0, "clear integer volume mip");
+			noError("indirect dispatch, mapping and clear");
+
+			if (@available(iOS 17.0, *)) {
+				const GLuint atomicProgram = resources.compute(R"(#version 430
+layout(local_size_x=8) in;
+layout(r32ui, binding=5) uniform uimage3D volume;
+layout(std430, binding=2) buffer Results { uint values[]; } outputData;
+shared uint count;
+void main() {
+    if (gl_LocalInvocationIndex == 0) count = 0;
+    barrier(); atomicAdd(count, 1); barrier();
+    imageAtomicAdd(volume, ivec3(0), count);
+    atomicAdd(outputData.values[0], 1);
+})");
+				glClearBufferSubData(GL_SHADER_STORAGE_BUFFER, GL_R32UI, offset, sizeof(result), GL_RED_INTEGER, GL_UNSIGNED_INT, nullptr);
+				glUseProgram(atomicProgram);
+				glDispatchCompute(1, 1, 1);
+				glMemoryBarrier(GL_ALL_BARRIER_BITS);
+				glGetTexImage(GL_TEXTURE_3D, 1, GL_RED_INTEGER, GL_UNSIGNED_INT, pixels.data());
+				glGetBufferSubData(GL_SHADER_STORAGE_BUFFER, offset, sizeof(result), result.data());
+				require(pixels[0] == 64 && result[0] == 8, "image, SSBO and shared-memory atomics");
+			}
+			// BufferData replaces the store and implicitly ends an existing mapping.
+			require(glMapBuffer(GL_SHADER_STORAGE_BUFFER, GL_WRITE_ONLY) != nullptr, "map before replacement");
+			glBufferData(GL_SHADER_STORAGE_BUFFER, 16, nullptr, GL_DYNAMIC_COPY);
+			GLint mappedState = GL_TRUE;
+			glGetBufferParameteriv(GL_SHADER_STORAGE_BUFFER, GL_BUFFER_MAPPED, &mappedState);
+			require(mappedState == GL_FALSE, "BufferData implicitly unmaps old storage");
+			noError("atomics and storage replacement");
+			GL4METAL_LOG("GPU resource tests passed");
+			return 0;
+		} catch (const std::exception &error) {
+			GL4METAL_LOG("GPU resource tests failed: %s", error.what());
+			return 1;
+		}
+	}
+}
