+int main(int argc, char **argv) {
+	try {
+		uint8_t integer[4] = {};
+		writeIntegerComponent(integer, 4, false, 0xf1234567u);
+		require(readIntegerComponent(integer, GL_UNSIGNED_INT) == 0xf1234567u, "full-width unsigned transfer");
+		writeIntegerComponent(integer, 4, true, -123456789, true);
+		require(readIntegerComponent(integer, GL_INT, true) == -123456789, "signed byte-swapped transfer");
+		writeIntegerComponent(integer, 1, false, -1);
+		require(integer[0] == 0, "signed to unsigned clamp");
+		writeIntegerComponent(integer, 1, true, 500);
+		require(integer[0] == 127, "integer narrowing clamp");
+		require(imageFormatClass(GL_R32UI) == imageFormatClass(GL_R32F) &&
+			imageFormatClass(GL_R32UI) != imageFormatClass(GL_RGBA8), "image compatibility classes");
+		auto images = compute(R"(#version 450
+#define IMAGE_UNIT (3 + 2)
+layout(local_size_x=4, local_size_y=2, local_size_z=2) in;
+layout(r32ui, binding=IMAGE_UNIT) uniform uimage3D volume[2];
+layout(rgba32i, binding=1) writeonly uniform iimage2D signedImage;
+layout(std430, binding=5) buffer Data { uint values[]; } data;
+void main() {
+    ivec3 p = ivec3(gl_GlobalInvocationID);
+    imageStore(volume[0], p, uvec4(data.values[0]));
+    imageStore(volume[1], p, imageLoad(volume[0], p));
+    imageStore(signedImage, p.xy, ivec4(-1));
+    data.values[gl_LocalInvocationIndex] = uint(data.values.length()) + gl_NumWorkGroups.x;
+})");
+		require(images.storage_images.size() == 3, "image array reflection");
+		for (const auto &image : images.storage_images) {
+			if (image.name == "volume[0]") {
+				require(image.binding == 5 && image.gl_type == GL_UNSIGNED_INT_IMAGE_3D, "macro image binding/type");
+				require(image.stage[2].present && image.is_3d, "compute image stage");
+			} else if (image.name == "volume[1]") require(image.binding == 6, "consecutive image array bindings");
+			else require(image.gl_type == GL_INT_IMAGE_2D && image.write_only, "signed image type/access");
+		}
+		require(images.needs_buffer_size_buffer[2], "SSBO runtime length helper");
+		require(images.workgroup_size[0] == 4 && images.workgroup_size[2] == 2, "3D workgroup dimensions");
+		require(images.msl[2].find("threadgroups_per_grid") != std::string::npos, "gl_NumWorkGroups mapping");
+
+		auto nested = compute(R"(#version 430
+layout(local_size_x=1) in;
+struct Particle { vec4 position; mat2 basis; uint flags[2]; };
+layout(std430, binding=2) buffer Particles { uint count; Particle particles[]; } state;
+void main() { state.particles[0].flags[1] = state.count + uint(state.particles.length()); }
+)");
+		require(nested.storage_buffers.size() == 1, "nested SSBO block count");
+		const auto &block = nested.storage_buffers[0];
+		require(block.runtime_sized && block.binding == 2 && block.required_size == 16, "runtime struct prefix/binding: " +
+			std::to_string(block.runtime_sized) + "/" + std::to_string(block.binding) + "/" + std::to_string(block.required_size));
+		require(block.members.size() == 4, "recursive SSBO leaf reflection");
+		require(block.data_size == 64, "query size includes one runtime struct element");
+		bool flags = false;
+		for (const auto &member : block.members) {
+			if (member.name == "Particles.particles[0].flags") {
+				flags = true;
+				require(member.stage[2].offset == 48 && member.stage[2].array_stride == 4, "nested array offset/stride");
+				require(member.array_size == 2 && member.top_level_array_size == 0 && member.top_level_array_stride == 48,
+					"nested versus top-level array metadata");
+			}
+		}
+		require(flags, "nested SSBO resource name");
+		auto anonymous = compute(R"(#version 430
+layout(local_size_x=1) in;
+layout(std430, binding=0) buffer Data { uint values[]; };
+void main() { values[0] = uint(values.length()); }
+)");
+		require(anonymous.storage_buffers[0].members[0].name == "values", "anonymous SSBO member name");
+		require(anonymous.storage_buffers[0].required_size == 0 && anonymous.storage_buffers[0].data_size == 4,
+			"empty runtime range versus query size");
+
+		TranslatedProgram graphics;
+		require(translateProgram(R"(#version 450
+layout(r32f, binding=4) readonly uniform image3D voxels;
+layout(std430, binding=2+3) buffer SharedData { vec4 value; } state;
+void main() { gl_Position = vec4(imageLoad(voxels, ivec3(0)).x) + state.value; }
+)", R"(#version 450
+layout(r32f, binding=4) readonly uniform image3D voxels;
+layout(rgba32f, binding=0) writeonly uniform image2D outputImage;
+layout(std430, binding=2+3) buffer SharedData { vec4 value; } state;
+layout(location=0) out vec4 color;
+void main() { color = imageLoad(voxels, ivec3(0)); imageStore(outputImage, ivec2(0), color); state.value = color; }
+)", graphics, {}), graphics.log);
+		require(graphics.storage_images.size() == 2, "shared graphics image uniform");
+		bool shared = false;
+		for (const auto &image : graphics.storage_images)
+			if (image.name == "voxels") shared = image.stage[0].present && image.stage[1].present && image.binding == 4;
+		require(shared, "per-stage graphics image slots");
+		require(graphics.storage_buffers.size() == 1 && graphics.storage_buffers[0].binding == 5 &&
+			graphics.storage_buffers[0].stage[0].present && graphics.storage_buffers[0].stage[1].present,
+			"graphics SSBO expression binding and stage merging");
+
+		const std::string atomicSource = R"(#version 430
+layout(local_size_x=8) in;
+layout(r32ui, binding=0) uniform uimage3D voxels;
+layout(std430, binding=0) buffer Counters { uint count; } counter;
+shared uint localCount;
+void main() {
+    if (gl_LocalInvocationIndex == 0) localCount = 0;
+    barrier();
+    atomicAdd(localCount, 1);
+    barrier();
+    uint previous = imageAtomicAdd(voxels, ivec3(gl_GlobalInvocationID), localCount);
+    atomicAdd(counter.count, previous);
+})";
+		TranslatedProgram atomic;
+		require(translateComputeProgram(atomicSource, atomic, 30100), atomic.log);
+		require(atomic.msl[2].find("atomic_fetch_add") != std::string::npos, "native image/SSBO atomics");
+		require(atomic.msl[2].find("threadgroup_barrier") != std::string::npos, "workgroup barrier");
+		TranslatedProgram legacyAtomic;
+		require(!translateComputeProgram(atomicSource, legacyAtomic, 20200), "old Metal must reject unsupported image atomics");
+
+		TranslatedProgram invalid;
+		require(!translateComputeProgram(R"(#version 430
+layout(local_size_x=1) in;
+layout(std430, binding=0) buffer Blocks { uint value; } blocks[2];
+void main() { blocks[0].value = blocks[1].value; }
+)", invalid), "unsupported block arrays must fail instead of binding the wrong buffer");
+		require(!translateComputeProgram("#version 430\nlayout(local_size_x=0) in; void main() {}", invalid), "invalid local size rejected");
+		std::string compileLog;
+		require(!validateComputeShader("#version 430\nlayout(local_size_x=1) in; void main() { broken; }", compileLog) &&
+			!compileLog.empty(), "compute compilation reports syntax errors");
+		if (argc == 2) {
+			std::filesystem::create_directories(argv[1]);
+			auto dump = [&](const char *name, const std::string &source) {
+				std::ofstream file(std::filesystem::path(argv[1]) / name);
+				file << source;
+				require(bool(file), "write MSL fixture");
+			};
+			dump("images.metal", images.msl[2]);
+			dump("nested.metal", nested.msl[2]);
+			dump("anonymous.metal", anonymous.msl[2]);
+			dump("vertex_images.metal", graphics.msl[0]);
+			dump("fragment_images.metal", graphics.msl[1]);
+			dump("atomics.metal", atomic.msl[2]);
+		}
+		std::cout << "All shader resource regression tests passed\n";
+		return EXIT_SUCCESS;
+	} catch (const std::exception &e) {
+		std::cerr << e.what() << '\n';
+		return EXIT_FAILURE;
+	}
